# 服务配置
PORT=8765

# RSS 基础配置
FEED_URL=http://192.168.123.100:8765

# 安全配置
AUTH_TOKEN=your-secret-token

# 日志级别（可选：debug, info, warn, error）
LOG_LEVEL=info

# 运行环境（可选：development, production）
NODE_ENV=development

# 频道创建模式
# public - 任何人都可以创建频道（默认）
# private - 仅超级管理员可以创建频道
CHANNEL_CREATION_MODE=public
